
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run SolWisp Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/SolWisp-VSCode"
